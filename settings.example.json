{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/skills/map/hooks/map-hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Loading project map"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/skills/map/hooks/map-signals.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/skills/map/hooks/map-signals.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
